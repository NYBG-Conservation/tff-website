# Local Django — copy to backend/.env (never commit backend/.env).
# See backend/.env.production.example for EC2 / NYBG-hosted SMTP.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=true

FRONTEND_URL=http://127.0.0.1:5173
DJANGO_API_PUBLIC_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound mail: with EMAIL_HOST empty, local/dev prints to the runserver console.
# Do not send real mail from a laptop using forest@nybg.org unless IT gave you SMTP.
DEFAULT_FROM_EMAIL=forest@nybg.org
RESEARCH_APPLICATION_NOTIFY=forest@nybg.org
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
