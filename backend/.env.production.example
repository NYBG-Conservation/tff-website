# Copy to backend/.env on the EC2 (or NYBG) host. Do not commit backend/.env.

DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=api.yourdomain.org,localhost,127.0.0.1

# Vercel site URL (for redirects / CSRF / CORS)
FRONTEND_URL=https://your-project.vercel.app
# Public URL of this Django host (admin links in emails)
DJANGO_API_PUBLIC_URL=https://api.yourdomain.org

# Amazon RDS — use either DATABASE_URL or POSTGRES_* (not both required if DATABASE_URL is set)
USE_SQLITE=false
DATABASE_URL=postgresql://dbuser:dbpassword@your-rds-endpoint.region.rds.amazonaws.com:5432/tff_db
# Or discrete vars:
# POSTGRES_DB=tff_db
# POSTGRES_USER=dbuser
# POSTGRES_PASSWORD=dbpassword
# POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
# POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Comma-separated; must include your Vercel deployment URL(s)
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://api.yourdomain.org
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
PORT=8000

# Reuse RDS connections for 60s (avoids a new SSL handshake on every admin click).
CONN_MAX_AGE=60
CONN_HEALTH_CHECKS=true

# false while using http://EC2_IP:8000; set true when API has HTTPS (ALB + api.yourdomain.org)
USE_HTTPS=false

# --- Outbound email (required for apply notices, invites, overdue-upload reminders) ---
# From address must be an NYBG mailbox covered by SPF (not Gmail).
DEFAULT_FROM_EMAIL=forest@nybg.org
SERVER_EMAIL=forest@nybg.org
RESEARCH_APPLICATION_NOTIFY=forest@nybg.org
#
# Leave EMAIL_HOST empty until NYBG IT confirms a relay this host can reach.
# An unreachable smtp.nybg.org from EC2 will block a Gunicorn worker (~10s) on every invite.
# EMAIL_HOST=smtp.nybg.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# After deploy:
#   docker compose -f docker-compose.prod.yml exec backend python backend/manage.py sendtestemail you@nybg.org
#   docker compose -f docker-compose.prod.yml exec backend python backend/manage.py check

# --- S3 object storage (Phase 2 — see docs/DEPLOYMENT.md) ---
# Use an IAM role on the EC2 instance instead of long-lived keys when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=tff-nybg-uploads-prod
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=   # optional CloudFront domain
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
