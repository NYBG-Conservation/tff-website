{
	"name": "urban-conservation-hub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepare:blue-zones-phase1": "node scripts/prepare-blue-zones-phase1.mjs",
		"prepare:blue-zones-phase1:with-boundaries": "node scripts/prepare-blue-zones-phase1.mjs --with-boundaries",
		"build:blue-zones-tiles": "node scripts/build-blue-zones-tiles.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"deploy": "npx vercel@latest --prod"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@stadiamaps/api": "^8.1.0",
		"@turf/helpers": "^7.3.4",
		"@turf/union": "^7.3.4",
		"@vercel/analytics": "^1.6.1",
		"gsap": "^3.14.2",
		"maplibre-gl": "^5.21.1"
	}
}
